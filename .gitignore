__pycache__/
*.pyc
.pytest_cache/
.test-tmp-*/
pytest-cache-files-*/
.venv/
venv/
*.egg-info/
build/
dist/

# generated data artifacts (regenerable from the synthetic generator; never commit)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# local model weights (never commit binaries)
/models/
*.gguf
*.safetensors
*.bin

# run artifacts
runs/
reports/*.json
reports/*.html
reports/extraction/
reports/runs/
reports/studies/
reports/drift/
!reports/.gitkeep

# Local verification and unfinished reviewer working copies
reports/.pipeline.lock
reports/dashboard*
reports/review-development/
reports/independent-reviews/
reports/*.log
reports/*.xml
